{
  ".source.c, .source.cpp, .source.objc, .source.objcpp": {
    "editor": {
      "commentStart": "// ",
      "commentDelimiters": {
        "block": ["/*", "*/"],
        "line": "//"
      },
      "increaseIndentPattern": "(?x) ^ .* \\{ [^}\"']* $ |^ .* \\( [^\\)\"']* $ |^ \\s* (public|private|protected): \\s* $ |^ \\s* @(public|private|protected) \\s* $ |^ \\s* \\{ \\} $",
      "decreaseIndentPattern": "(?x) ^ \\s* (\\s* /[*] .* [*]/ \\s*)* \\} |^ \\s* (\\s* /[*] .* [*]/ \\s*)* \\) |^ \\s* (public|private|protected): \\s* $ |^ \\s* @(public|private|protected) \\s* $"
    }
  },
  ".source.c, .source.cpp": {
    "editor": {
      "foldEndPattern": "(?<!\\*)\\*\\*/|^\\s*\\}"
    }
  }
}
