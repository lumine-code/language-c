{
  "name": "C",
  "scopeName": "source.c",
  "type": "tree-sitter",
  "parser": "tree-sitter-c",
  "firstLineRegex": "-\\*-[^*]*(Mode:\\s*)?C(\\s*;.*?)?\\s*-\\*-",
  "injectionNames": ["c"],
  "treeSitter": {
    "parserSource": "github:tree-sitter/tree-sitter-c#v0.24.2",
    "wasmBuildTool": "tree-sitter-cli#v0.26.13",
    "grammar": "c.wasm",
    "languageSegment": "c",
    "highlightsQuery": ["c-shared-highlights.scm", "c-highlights.scm"],
    "tagsQuery": "c-tags.scm",
    "foldsQuery": "c-folds.scm",
    "indentsQuery": "c-indents.scm"
  },
  "fileTypes": ["h", "c", "h.in", "xpm"],
  "comments": {
    "start": "// "
  }
}
