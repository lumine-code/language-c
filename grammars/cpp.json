{
  "name": "C++",
  "scopeName": "source.cpp",
  "type": "tree-sitter",
  "parser": "tree-sitter-cpp",
  "injectionNames": ["c++", "cpp"],
  // A modeline is the usual way a header with no extension declares itself C++.
  "firstLineRegex": [
    "-\\*-[^*]*(?:[Mm]ode\\s*:\\s*)?[Cc]\\+\\+(?:\\s*;.*?)?\\s*-\\*-",
    "vim\\b.*\\bset\\b.*\\b(filetype|ft|syntax)=(cpp|c\\+\\+)"
  ],
  "treeSitter": {
    "parserSource": "github:tree-sitter/tree-sitter-cpp#v0.23.4",
    "wasmBuildTool": "tree-sitter-cli#v0.26.13",
    "grammar": "cpp.wasm",
    "languageSegment": "cpp",
    "highlightsQuery": ["c-shared-highlights.scm", "cpp-highlights.scm"],
    "tagsQuery": "cpp-tags.scm",
    "foldsQuery": "cpp-folds.scm",
    "indentsQuery": "cpp-indents.scm"
  },
  "fileTypes": [
    "cc",
    "cpp",
    "cp",
    "cxx",
    "c++",
    "cu",
    "cuh",
    "h",
    "hh",
    "hpp",
    "hxx",
    "h++",
    "inl",
    "ino",
    "ipp",
    "tcc",
    "tpp"
  ],
  "contentRegex": "\n\\s*(namespace|class|template)\\s+",
  "comments": {
    "start": "// "
  }
}
